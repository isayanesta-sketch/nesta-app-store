<!doctype html><html lang="mg"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Admin - NESTA APP STORE</title><link rel="stylesheet" href="/style.css"><style>
.panel{max-width:680px;margin:28px auto;padding:22px;background:white;border-radius:14px;border:1px solid #e1e8f0}.panel input,.panel textarea,.panel select{width:100%;padding:12px;margin:7px 0 13px;border:1px solid #cbd5e1;border-radius:8px;font-size:15px}.panel button{padding:11px 16px;background:#1456a0;color:white;border:0;border-radius:8px;font-weight:bold;cursor:pointer}.hint{font-size:13px;color:#64748b}.result{white-space:pre-wrap;font-size:14px;margin-top:15px}.item{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:12px 0;border-bottom:1px solid #e5eaf0}.item button{background:#a52828}
</style></head><body><header><div class="brand">NESTA <span>APP STORE</span> · ADMIN</div><p>Fitantanana ny application</p></header>
<main class="panel"><h2>Hampiditra APK vaovao</h2><label>Mot de passe admin</label><input id="password" type="password" autocomplete="current-password" placeholder="Mot de passe admin">
<label>Anaran'ny application</label><input id="name" placeholder="Ohatra: NESTA Music">
<label>Sokajy</label><select id="category"><option>Outils</option><option>Jeux</option><option>Musique et vidéo</option><option>Réseaux sociaux</option><option>Éducation</option><option>Navigateurs</option><option>Autres</option></select>
<label>Version</label><input id="version" value="1.0"><label>Famaritana</label><textarea id="description" rows="3" placeholder="Inona no asan'ity application ity?"></textarea>
<label>Rakitra APK</label><input id="apk" type="file" accept=".apk,application/vnd.android.package-archive"><p class="hint">APK ihany no azo ampidirina. Fetra default: 250 MB.</p>
<button id="upload">Ampidiro ao amin'ny serveur</button><div id="result" class="result"></div><hr><h2>APK efa nampidirina</h2><button id="refresh">Havaozy ny lisitra</button><div id="list"></div></main><script src="/admin.js"></script></body></html>
